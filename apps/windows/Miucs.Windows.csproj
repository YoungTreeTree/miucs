<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Miucs</AssemblyName>
    <RootNamespace>Miucs.Windows</RootNamespace>
    <ApplicationIcon>../assets/Miucs.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Miucs.Windows.Program</StartupObject>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../assets/cat-head.png" LogicalName="Miucs.PixelCatHead.png" />
    <Compile Include="../../modules/audio/platforms/windows/**/*.cs" />
    <Compile Include="../../modules/plugins/platforms/windows/**/*.cs" />
    <Compile Include="../../modules/keyboard/platforms/windows/**/*.cs" />
    <Compile Include="../../modules/visualizations/api/platforms/windows/**/*.cs" />
  </ItemGroup>
</Project>
