{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miucs:plugins:manifest:1",
  "title": "Miucs plugin manifest v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api",
    "entry",
    "inputs",
    "layout"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "api": {
      "const": 1
    },
    "entry": {
      "type": "string",
      "pattern": "\\.lua$"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio",
          "keyboard"
        ]
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "width",
        "height",
        "minimumWidth",
        "maximumWidth"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096
        },
        "minimumWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096
        },
        "maximumWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096
        }
      }
    },
    "visualizations": false,
    "tray": false
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    }
  }
}
